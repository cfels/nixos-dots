#!/usr/bin/env bash
set -euo pipefail

dir="${HOME}/walls"
[ -d "$dir" ] || exit 0

current="${HOME}/.cache/current-wallpaper"
image=""

if [ -s "$current" ]; then
	image="$(head -n 1 "$current")"
fi

if [ ! -f "$image" ]; then
	mapfile -t images < <(find -L "$dir" -maxdepth 1 -type f 2>/dev/null | grep -Ei '\.(jpg|jpeg|png|webp|gif|mp4|m4v|webm|mkv|mov|avi)$' | sort)

	if [ "${#images[@]}" -eq 0 ]; then
		exit 0
	fi

	image="$(printf '%s\n' "${images[@]}" | shuf -n 1)"
fi

exec "${HOME}/.config/hypr/scripts/wallpaper-set.sh" "$image"
