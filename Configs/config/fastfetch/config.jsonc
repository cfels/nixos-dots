{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "kitty-icat",
      "source": "$HOME/nixos-dots/Configs/config/fastfetch/larpchyon.gif",
      "width": 46,
      "height": 46
      //"color": {
       // "1": "38;2;203;166;247",
      //}
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╭──────────────────────Hardware──────────────────────╮"
        },
        {
            "type": "host",
            "key": "  󰇄  PC",
            "keyColor": "38;2;242;205;205"
        },
        {
            "type": "cpu",
            "key": "  ├  ",
            "showPeCoreCount": true,
            "keyColor": "38;2;242;205;205"
        },
        {
            "type": "gpu",
            "key": "  ├ 󰢮 ",
            "keyColor": "38;2;242;205;205"
        },
        {
            "type": "memory",
            "key": "  ├  ",
            "keyColor": "38;2;242;205;205"
        },
        {
            "type": "disk",
            "key": "  ╰  ",
            "folders": "/",
            "keyColor": "38;2;242;205;205"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╰────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╭──────────────────────Software──────────────────────╮"
        },
        {
            "type": "os",
            "key": "   OS",
            "keyColor": "38;2;245;194;231"
        },
        {
            "type": "kernel",
            "key": "  ├  ",
            "keyColor": "38;2;245;194;231"
        },
        {
            "type": "packages",
            "key": "  ├  ",
            "keyColor": "38;2;245;194;231"
        },
        {
            "type": "shell",
            "key": "  ╰  ",
            "keyColor": "38;2;245;194;231"
        },
        "break",
        {
            "type": "de",
            "key": "  DE",
            "keyColor": "38;2;203;166;247"
        },
        {
            "type": "lm",
            "key": "  ╭ 󰍂 ",
            "keyColor": "38;2;203;166;247"
        },
        {
            "type": "wm",
            "key": "  ├  ",
            "keyColor": "38;2;203;166;247"
        },
        {
            "type": "gpu",
            "key": "  ├ 󰾲 ",
            "format": "{3}",
            "keyColor": "38;2;203;166;247"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m  ╰────────────────────────────────────────╯"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╰────────────────────────────────────────────────────╯"
        },
        "break"
    ]
}
