{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      //"type": "kitty-icat",
      //"source": "$HOME/nixos-dots/Configs/config/fastfetch/larpchyon.gif",
      //"width": 46,
      //"height": 46
      //"color": {
       // "1": "38;2;220;198;110",
      //}
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;220;198;110m╭──────────────────────Hardware──────────────────────╮"
        },
        {
            "type": "host",
            "key": "  󰇄  PC",
            "keyColor": "38;2;169;208;179"
        },
        {
            "type": "cpu",
            "key": "  ├  ",
            "showPeCoreCount": true,
            "keyColor": "38;2;169;208;179"
        },
        {
            "type": "gpu",
            "key": "  ├ 󰢮 ",
            "keyColor": "38;2;169;208;179"
        },
        {
            "type": "memory",
            "key": "  ├  ",
            "keyColor": "38;2;169;208;179"
        },
        {
            "type": "disk",
            "key": "  ╰  ",
            "folders": "/",
            "keyColor": "38;2;169;208;179"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;220;198;110m╰────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;220;198;110m╭──────────────────────Software──────────────────────╮"
        },
        {
            "type": "os",
            "key": "   OS",
            "keyColor": "38;2;209;198;161"
        },
        {
            "type": "kernel",
            "key": "  ├  ",
            "keyColor": "38;2;209;198;161"
        },
        {
            "type": "packages",
            "key": "  ├  ",
            "keyColor": "38;2;209;198;161"
        },
        {
            "type": "shell",
            "key": "  ╰  ",
            "keyColor": "38;2;209;198;161"
        },
        "break",
        {
            "type": "de",
            "key": "  ╭  ",
            "keyColor": "38;2;220;198;110"
        },
        {
            "type": "lm",
            "key": "  ├ 󰍂 ",
            "keyColor": "38;2;220;198;110"
        },
        {
            "type": "wm",
            "key": "  ├  ",
            "keyColor": "38;2;220;198;110"
        },
        {
            "type": "gpu",
            "key": "  ├ 󰾲 ",
            "format": "{3}",
            "keyColor": "38;2;220;198;110"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;220;198;110m  ╰────────────────────────────────────────╯"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;220;198;110m╰────────────────────────────────────────────────────╯"
        },
        "break"
    ]
}
