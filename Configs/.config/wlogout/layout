{
    "label" : "lock",
    "action" : "bash -c 'pidof hyprlock || hyprlock'",
    "text" : "LOCK",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "bash -c 'hyprctl dispatch exit || uwsm stop'",
    "text" : "LOGOUT",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "bash -c 'systemctl suspend'",
    "text" : "SUSPEND",
    "keybind" : "s"
}
{
    "label" : "hibernate",
    "action" : "bash -c 'systemctl hibernate'",
    "text" : "HIBERNATE",
    "keybind" : "h"
}
{
    "label" : "shutdown",
    "action" : "bash -c 'systemctl poweroff'",
    "text" : "SHUTDOWN",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "bash -c 'systemctl reboot'",
    "text" : "REBOOT",
    "keybind" : "r"
}
